{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "1100px", "wideSize": "1280px" },
		"color": {
			"palette": [
				{ "slug": "ink", "name": "Encre", "color": "#1a1410" },
				{ "slug": "cream", "name": "Crème", "color": "#fff6e0" },
				{ "slug": "yellow", "name": "Jaune", "color": "#ebd01e" },
				{ "slug": "orange", "name": "Orange", "color": "#ea8718" },
				{ "slug": "red", "name": "Rouge", "color": "#c0351d" },
				{ "slug": "brown", "name": "Brun", "color": "#974028" },
				{ "slug": "muted", "name": "Gris chaud", "color": "#6b5e50" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "body", "name": "Texte", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" },
				{ "slug": "heading", "name": "Titres", "fontFamily": "Rockwell, \"Roboto Slab\", \"Rockwell Nova\", Georgia, serif" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem" },
				{ "slug": "medium", "size": "1.1rem" },
				{ "slug": "large", "size": "clamp(1.4rem, 1.1rem + 1vw, 1.9rem)" },
				{ "slug": "x-large", "size": "clamp(2rem, 1.4rem + 2.4vw, 3.2rem)" },
				{ "slug": "huge", "size": "clamp(2.6rem, 1.6rem + 4.5vw, 5.2rem)" }
			]
		},
		"spacing": { "units": ["px", "rem", "%", "vw"] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--cream)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
		"spacing": { "blockGap": "1.5rem" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "900", "lineHeight": "1.1", "textTransform": "uppercase" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": { "color": { "text": "var(--wp--preset--color--red)" }, ":hover": { "color": { "text": "var(--wp--preset--color--ink)" } } },
			"button": {
				"color": { "background": "var(--wp--preset--color--red)", "text": "#ffffff" },
				"typography": { "fontWeight": "800", "textTransform": "uppercase", "letterSpacing": "0.04em", "fontSize": "var(--wp--preset--font-size--small)" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.8rem", "right": "1.8rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--ink)", "text": "#ffffff" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--ink)", "width": "3px", "offset": "2px" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontWeight": "800", "textTransform": "uppercase", "fontSize": "var(--wp--preset--font-size--small)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	]
}
